# =================================================================
# PlaceMate AI — Environment Variable Reference & Deployment Template
# =================================================================
# Copy this file to .env for local development.
# In production, configure these variables in Render and Vercel dashboards.
# DO NOT COMMIT REAL CREDENTIALS, PASSWORDS, OR SECRETS TO VERSION CONTROL.

# -----------------------------------------------------------------
# 1. Server & Runtime Configuration (Render Web Service)
# -----------------------------------------------------------------
PORT=3000
NODE_ENV=production

# -----------------------------------------------------------------
# 2. Database Configuration (MongoDB Atlas)
# -----------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster-domain>/placemate?retryWrites=true&w=majority
# Make sure your MongoDB Atlas Network Access has IP 0.0.0.0/0 allowed for Render cloud egress.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-host>.mongodb.net/placemate?retryWrites=true&w=majority"

# -----------------------------------------------------------------
# 3. Security & Authentication (Render Web Service)
# -----------------------------------------------------------------
# Generate a strong 64-character random string (e.g. openssl rand -hex 32)
JWT_SECRET="your_strong_jwt_secret_key_minimum_32_characters"

# -----------------------------------------------------------------
# 4. Google Gemini AI Engine (Render Web Service)
# -----------------------------------------------------------------
# Acquire key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_google_gemini_api_key_here"

# -----------------------------------------------------------------
# 5. Cross-Origin Resource Sharing (CORS) Configuration (Render Web Service)
# -----------------------------------------------------------------
# The production URL of your Vercel frontend deployment
FRONTEND_URL="https://placemate-ai.vercel.app"

# Optional CORS wildcard override (leave empty or use FRONTEND_URL in production)
CORS_ORIGIN=""

# -----------------------------------------------------------------
# 6. Email / OTP Notification Service (Render Web Service)
# -----------------------------------------------------------------
# Gmail App Password or institutional SMTP credentials
SMTP_USER="your-placement-email@campus.edu"
SMTP_PASS="your-16-character-app-password"

# Canonical Application Public URL
APP_URL="https://placemate-ai.vercel.app"

# -----------------------------------------------------------------
# 7. Frontend Deployment Configuration (Vercel Project Settings)
# -----------------------------------------------------------------
# Set this in Vercel -> Project Settings -> Environment Variables
# Points the Vercel React frontend to your deployed Render Express backend
VITE_API_URL="https://placemate-backend.onrender.com"

# -----------------------------------------------------------------
# 8. Optional Voice & Avatar AI Services (Render Web Service)
# -----------------------------------------------------------------
# OpenAI TTS for Sarah Jenkins voice generation (TTS-1 nova)
OPENAI_API_KEY="your_openai_api_key"
VOICE="your_openai_api_key"

# HeyGen LiveAvatar credentials (optional)
HEYGEN_API_KEY="your_heygen_api_key"
HEYGEN_AVATAR_ID="your_heygen_avatar_id"
HEYGEN_VOICE_ID="your_heygen_voice_id"
